# Copia este archivo como .env.local (git lo ignora). Valores del stack del lab: salidas de
# CloudFormation o el README. Son identificadores públicos, no secretos.

# URL base de la API, sin barra final. En local usa /api junto con API_PROXY_TARGET.
# Si se deja vacía, el frontend usa los parqueaderos de demostración.
NEXT_PUBLIC_API_URL=
# Solo desarrollo: destino del proxy /api de Next.js (salida ApiUrl del stack). Evita el CORS de la
# API, que solo permite el dominio publicado.
API_PROXY_TARGET=
# User Pool de Cognito (salidas UserPoolId y UserPoolClientId).
# Sin ellos no se exige sesión: sirve para trabajar con los datos de demostración.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
# Dominio del Hosted UI de Cognito (salida CognitoDomain del stack), sin https://.
# Necesario para el botón "Continuar con Google".
NEXT_PUBLIC_COGNITO_DOMAIN=

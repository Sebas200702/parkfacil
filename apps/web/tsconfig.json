{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@app/*": ["src/app/*"],
      "@components/*": ["src/components/*"],
      "@context/*": ["src/context/*"],
      "@features/*": ["src/features/*"],
      "@lib/*": ["src/lib/*"],
      "@pages/*": ["src/screens/*"],
      "@shared/*": ["src/shared/*"],
      "@tests/*": ["src/__tests__/*"]
    }
  },
  "include": ["src", "vitest.config.ts", "next-env.d.ts", ".next/types/**/*.ts"]
}
